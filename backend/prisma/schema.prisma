generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  CPPD_CENTRAL
  CPPD_MEMBER
  DOCENTE
  EXTERNAL_EVALUATOR
}

enum PersonType {
  TEACHER
  CPPD_MEMBER
  EXTERNAL_EVALUATOR
  OTHER
}

enum ProcessTypeCategory {
  CAREER
  RSC
  FULL_PROFESSOR
}

enum ScoringTablePurpose {
  PROGRESSION_PROMOTION
  RSC
  FULL_PROFESSOR_EVALUATION
  OTHER
}

enum CppdMemberFunction {
  PRESIDENT
  SECRETARY
  MEMBER
}

enum CommissionMembershipType {
  PRIMARY
  SUBSTITUTE
}

enum SpecialCommissionType {
  RSC
  FULL_PROFESSOR
}

enum CommissionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum SpecialCommissionMemberOrigin {
  INTERNAL
  EXTERNAL
}

enum SpecialCommissionMemberRole {
  PRESIDENT
  MEMBER
  PRIMARY
  SUBSTITUTE
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum FullProfessorEvaluationMode {
  MEMORIAL
  THESIS
}

enum FullProfessorProcedureStage {
  INITIAL_EVALUATION
  AWAITING_REASSESSMENT
  REASSESSMENT_REQUESTED
  ORAL_DEFENSE_SCHEDULED
  THESIS_DEFENSE_RECORDED
  AWAITING_APPEAL
  APPEAL_SUBMITTED
  COMPLETED
}

enum FullProfessorProcedureOutcome {
  APPROVED
  REJECTED
}

enum FullProfessorProcedureEventType {
  INITIAL_OUTCOME_RECORDED
  REASSESSMENT_REQUESTED
  ORAL_DEFENSE_SCHEDULED
  ORAL_DEFENSE_RECORDED
  APPEAL_SUBMITTED
  APPEAL_DECIDED
  DEADLINE_EXPIRED
}

enum IndividualEvaluationType {
  RSC
  FULL_PROFESSOR
  CPPD
  OTHER
}

enum IndividualEvaluationStatus {
  DRAFT
  SUBMITTED
  RETURNED
  CANCELED
}

enum IndividualEvaluationResult {
  APPROVED
  REJECTED
  DEFERRED
  DENIED
}

model User {
  idUser       Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(180)
  phone        String?   @db.VarChar(20)
  city         String?
  uf           String?
  cpf          String?   @unique @db.VarChar(14)
  cpfEncrypted String?   @db.VarChar(255)
  cpfHash      String?   @unique @db.VarChar(64)
  personId     Int?      @unique
  passwordHash String?   @db.VarChar(200)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deletedDate  DateTime?
  updatedAt    DateTime  @updatedAt

  person                       Person?                       @relation(fields: [personId], references: [idPerson], onDelete: SetNull)
  roles                        UserRole[]
  docente                      DocenteProfile?
  externalEvaluator            ExternalEvaluatorProfile?
  CareerProcess                CareerProcess[]
  ProcessStatusHistory         ProcessStatusHistory[]
  evidenceFiles                EvidenceFile[]
  passwordResetCodes           PasswordResetCode[]
  generatedDocuments           DocumentProcess[]
  fullProfessorProcedureEvents FullProfessorProcedureEvent[]

  @@map("user")
}

//tabela separada para facilitar futuras expansões (ex: grupos de permissões)
model Role {
  idRole      BigInt     @id @default(autoincrement())
  name        RoleName   @unique
  createdAt   DateTime   @default(now())
  deletedDate DateTime?
  updatedAt   DateTime   @updatedAt
  users       UserRole[]

  @@map("role")
}

model UserRole {
  userId      Int
  roleId      BigInt
  assignedAt  DateTime  @default(now())
  deletedDate DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [idRole], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model Campus {
  idCampus    Int       @id @default(autoincrement())
  name        String    @db.VarChar(120)
  acronym     String?   @unique @db.VarChar(20)
  cppdEmail   String?   @db.VarChar(180)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedDate DateTime?

  docentes        DocenteProfile[]
  processes       CareerProcess[]
  cppdCommissions CppdCommission[]

  @@map("campus")
}

model Person {
  idPerson     Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  email        String?    @unique @db.VarChar(180)
  phone        String?    @db.VarChar(20)
  cpfEncrypted String?    @db.VarChar(255)
  cpfHash      String?    @unique @db.VarChar(64)
  type         PersonType @default(OTHER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedDate  DateTime?

  users                        User[]
  cppdMemberships              CppdCommissionMember[]
  specialCommissionMemberships SpecialCommissionMember[]

  @@index([type, active])
  @@map("person")
}

model ExternalEvaluatorProfile {
  idExternalEvaluator Int       @id @default(autoincrement())
  userId              Int       @unique
  title               String?   @db.VarChar(120)
  institution         String?   @db.VarChar(180)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  deletedDate         DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [idUser], onDelete: Cascade)

  @@map("external_evaluator_profile")
}

//tabela com dados específicos do docente, para permitir perfil de docente e membro da CPPD
model DocenteProfile {
  idDocente            Int        @id @default(autoincrement())
  userId               Int        @unique
  campusId             Int?
  siape                String     @db.VarChar(30)
  classLevel           ClassLevel
  start_interstice     DateTime //data do início do interstício atual
  educationLevel       String     @db.VarChar(120)
  improvement          String?    @db.VarChar(120)
  specialization       String?    @db.VarChar(120)
  mastersDegree        String?    @db.VarChar(120)
  doctorate            String?    @db.VarChar(120)
  assignment           String?    @db.VarChar(120)
  department           String?    @db.VarChar(120)
  division             String?    @db.VarChar(120)
  role                 String?    @db.VarChar(120)
  immediate_supervisor String?    @db.VarChar(120)
  user                 User       @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  campus               Campus?    @relation(fields: [campusId], references: [idCampus], onDelete: SetNull)
  createdAt            DateTime   @default(now())
  deletedDate          DateTime?
  updatedAt            DateTime   @updatedAt

  degrees TeacherDegree[]

  @@index([campusId])
  @@map("docente_profile")
}

enum ClassLevel {
  A1
  B1
  B2
  B3
  B4
  C1
  C2
  C3
  C4
  D1
}

model ScoringTable {
  idScoringTable    Int                 @id @default(autoincrement())
  name              String              @db.VarChar(120)
  purpose           ScoringTablePurpose @default(PROGRESSION_PROMOTION)
  startsOn          DateTime?
  endsOn            DateTime?
  minRequiredPoints Decimal?            @db.Decimal(10, 2)
  status            ScoringTableStatus  @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedDate       DateTime?

  nodes         ScoringNode[]
  items         ScoringItem[]
  CareerProcess CareerProcess[]

  @@map("scoring_table")
}

enum ScoringTableStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model ScoringNode {
  idScoringNode     Int                @id @default(autoincrement())
  scoringTableId    Int
  parentId          Int?
  name              String             @db.VarChar(500)
  code              String?            @db.VarChar(50)
  sortOrder         Int                @default(0)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedDate       DateTime?
  hasFormula        Boolean            @default(false)
  formulaExpression String?            @db.VarChar(255)
  maxPoints         Decimal?           @db.Decimal(10, 2)
  table             ScoringTable       @relation(fields: [scoringTableId], references: [idScoringTable], onDelete: Cascade)
  parent            ScoringNode?       @relation("NodeChildren", fields: [parentId], references: [idScoringNode], onDelete: Cascade)
  children          ScoringNode[]      @relation("NodeChildren")
  items             ScoringItem[]
  nodeScores        ProcessNodeScore[] // relação com a tabela nova

  @@unique([scoringTableId, parentId, name], name: "uq_sibling_name")
  @@index([scoringTableId, parentId, sortOrder])
  @@map("scoring_node")
}

model ScoringItem {
  idScoringItem  Int       @id @default(autoincrement())
  scoringTableId Int
  nodeId         Int
  description    String    @db.VarChar(1000)
  points         Decimal   @db.Decimal(10, 2)
  unit           String?   @db.VarChar(30)
  weight         Decimal?  @db.Decimal(10, 2)
  factor         Decimal?  @db.Decimal(10, 2)
  hasMaxPoints   Boolean   @default(false)
  maxPoints      Decimal?  @db.Decimal(10, 2)
  maxQuantity    Int?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedDate    DateTime?
  formulaKey     String?   @db.VarChar(30)

  table                      ScoringTable                @relation(fields: [scoringTableId], references: [idScoringTable], onDelete: Cascade)
  node                       ScoringNode                 @relation(fields: [nodeId], references: [idScoringNode], onDelete: Cascade)
  ProcessScore               ProcessScore[]
  individualEvaluationScores IndividualEvaluationScore[]

  @@index([nodeId])
  @@map("scoring_item")
}

model ProcessNodeScore {
  idProcessNodeScore   Int       @id @default(autoincrement())
  processId            Int
  nodeId               Int
  totalPoints          Decimal   @db.Decimal(10, 2)
  evaluatorTotalPoints Decimal?  @db.Decimal(10, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedDate          DateTime?

  process CareerProcess @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  node    ScoringNode   @relation(fields: [nodeId], references: [idScoringNode], onDelete: Cascade)

  @@unique([processId, nodeId])
  @@map("process_node_score")
}

enum ProcessType {
  PROGRESSAO
  PROMOCAO
}

enum ProcessStatus {
  DRAFT //rascunho do docente
  DOCUMENTATION_PENDING
  SUBMITTED //enviado pelo docente
  AWAITING_EVALUATOR_ACCEPTANCE
  AWAITING_ORDINANCE
  UNDER_REVIEW //em análise pela CPPD
  IN_EVALUATION
  APPROVED
  REJECTED
  RETURNED //devolvido ao docente para ajustes
  FINALIZED
}

model CareerProcess {
  idProcess       Int           @id @default(autoincrement())
  userId          Int
  campusId        Int?
  processTypeId   Int?
  scoringTableId  Int? // Tabela vigente fixada na abertura quando o tipo exige pontuação
  type            ProcessType? // Compatibilidade com processos legados de progressão/promoção
  status          ProcessStatus @default(DRAFT)
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedDate     DateTime?
  campus          String        @db.VarChar(255)
  cidadeUF        String        @db.VarChar(255)
  externalNumber  String?       @db.VarChar(120)
  intersticeStart DateTime?
  intersticeEnd   DateTime?
  classeOrigem    String?       @db.VarChar(20)
  nivelOrigem     String?       @db.VarChar(20)
  classeDestino   String?       @db.VarChar(20)
  nivelDestino    String?       @db.VarChar(20)

  user              User               @relation(fields: [userId], references: [idUser], onDelete: Restrict)
  campusRef         Campus?            @relation(fields: [campusId], references: [idCampus], onDelete: SetNull)
  processTypeConfig ProcessTypeConfig? @relation(fields: [processTypeId], references: [idProcessType], onDelete: SetNull)
  table             ScoringTable?      @relation(fields: [scoringTableId], references: [idScoringTable], onDelete: Restrict)
  finalPoints       Decimal?           @db.Decimal(10, 2)
  evaluationOpinion String?            @db.Text
  evaluatorUserIds  Json?

  scores                ProcessScore[]
  ProcessStatusHistory  ProcessStatusHistory[]
  processNodeScores     ProcessNodeScore[]
  progressionDetail     ProgressionProcessDetail?
  rscDetail             RscProcessDetail?
  fullProfessorDetail   FullProfessorProcessDetail?
  documents             DocumentProcess[]
  specialCommissions    SpecialCommission[]
  individualEvaluations IndividualEvaluation[]

  @@index([userId, status])
  @@index([campusId])
  @@index([processTypeId])
  @@index([scoringTableId])
  @@index([externalNumber])
  @@map("process")
}

model ProcessScore {
  idProcessScore Int @id @default(autoincrement())
  processId      Int
  itemId         Int

  quantity      Int     @default(0)
  awardedPoints Decimal @db.Decimal(10, 2)

  evidenceFileId Int?
  evidenceFile   EvidenceFile? @relation(fields: [evidenceFileId], references: [idEvidenceFile], onDelete: Restrict)

  evaluatorAwardedPoints Decimal? @db.Decimal(10, 2)
  evaluatorComment       String?  @db.VarChar(500)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedDate DateTime?

  process CareerProcess @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  item    ScoringItem   @relation(fields: [itemId], references: [idScoringItem], onDelete: Restrict)

  @@unique([processId, itemId])
  @@index([itemId])
  @@map("process_score")
}

model ProcessStatusHistory {
  idStatusHist Int            @id @default(autoincrement())
  processId    Int
  fromStatus   ProcessStatus?
  toStatus     ProcessStatus
  changedById  Int
  note         String?        @db.VarChar(500)
  updatedAt    DateTime       @default(now())
  createdAt    DateTime       @default(now())
  deletedDate  DateTime?

  process   CareerProcess @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  changedBy User          @relation(fields: [changedById], references: [idUser], onDelete: Restrict)

  @@index([processId, updatedAt])
  @@map("process_status_history")
}

model ProcessTypeConfig {
  idProcessType      Int                 @id @default(autoincrement())
  code               String              @db.VarChar(60)
  name               String              @db.VarChar(120)
  category           ProcessTypeCategory
  version            Int                 @default(1)
  validFrom          DateTime            @default(now())
  validUntil         DateTime?
  requiresScoring    Boolean             @default(false)
  requiresCommittee  Boolean             @default(false)
  defaultDestination String?             @db.VarChar(120)
  opinionTemplateId  Int?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedDate        DateTime?

  opinionTemplate      DocumentTemplate?                @relation("DefaultOpinionTemplate", fields: [opinionTemplateId], references: [idDocumentTemplate], onDelete: SetNull)
  templates            DocumentTemplate[]               @relation("ProcessTypeTemplates")
  documentRequirements ProcessTypeDocumentRequirement[]
  processes            CareerProcess[]

  @@unique([code, version])
  @@index([category, active])
  @@index([opinionTemplateId])
  @@map("process_type_config")
}

model ProcessTypeDocumentRequirement {
  idDocumentRequirement Int       @id @default(autoincrement())
  processTypeId         Int
  code                  String    @db.VarChar(60)
  name                  String    @db.VarChar(120)
  description           String?   @db.VarChar(500)
  required              Boolean   @default(true)
  allowsMultiple        Boolean   @default(false)
  acceptedFormats       String?   @db.VarChar(120)
  maxSizeMb             Int?
  sortOrder             Int       @default(0)
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedDate           DateTime?

  processType ProcessTypeConfig @relation(fields: [processTypeId], references: [idProcessType], onDelete: Cascade)

  @@unique([processTypeId, code])
  @@index([processTypeId, active])
  @@map("process_type_document_requirement")
}

model TeacherDegree {
  idTeacherDegree Int       @id @default(autoincrement())
  teacherId       Int
  degreeType      String    @db.VarChar(80)
  course          String?   @db.VarChar(180)
  institution     String?   @db.VarChar(180)
  conclusionDate  DateTime?
  evidenceFileId  Int?
  validatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedDate     DateTime?

  teacher              DocenteProfile               @relation(fields: [teacherId], references: [idDocente], onDelete: Cascade)
  evidenceFile         EvidenceFile?                @relation(fields: [evidenceFileId], references: [idEvidenceFile], onDelete: SetNull)
  fullProfessorDetails FullProfessorProcessDetail[]

  @@index([teacherId])
  @@index([evidenceFileId])
  @@map("teacher_degree")
}

model ProgressionProcessDetail {
  processId       Int       @id
  originClass     String?   @db.VarChar(20)
  originLevel     String?   @db.VarChar(20)
  targetClass     String?   @db.VarChar(20)
  targetLevel     String?   @db.VarChar(20)
  intersticeStart DateTime?
  intersticeEnd   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedDate     DateTime?

  process CareerProcess @relation(fields: [processId], references: [idProcess], onDelete: Cascade)

  @@map("progression_process_detail")
}

model RscProcessDetail {
  processId                  Int       @id
  targetLevel                String?   @db.VarChar(20)
  careerEntryDate            DateTime?
  previousRscGrantedAt       DateTime?
  activityPeriodStart        DateTime?
  activityPeriodEnd          DateTime?
  truthDeclarationAcceptedAt DateTime?
  reportFileId               Int?
  generatedSpreadsheetFileId Int?
  finalResult                String?   @db.VarChar(60)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedDate                DateTime?

  process                  CareerProcess @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  reportFile               EvidenceFile? @relation("RscReportFile", fields: [reportFileId], references: [idEvidenceFile], onDelete: SetNull)
  generatedSpreadsheetFile EvidenceFile? @relation("RscGeneratedSpreadsheetFile", fields: [generatedSpreadsheetFileId], references: [idEvidenceFile], onDelete: SetNull)

  @@index([reportFileId])
  @@index([generatedSpreadsheetFileId])
  @@map("rsc_process_detail")
}

model FullProfessorProcessDetail {
  processId               Int                            @id
  evaluationMode          FullProfessorEvaluationMode?
  memorialFileId          Int?
  thesisFileId            Int?
  doctorateDegreeId       Int?
  finalReferenceDate      DateTime?
  procedureStage          FullProfessorProcedureStage    @default(INITIAL_EVALUATION)
  currentOutcome          FullProfessorProcedureOutcome?
  evaluationDeadlineAt    DateTime?
  initialOpinionAt        DateTime?
  reassessmentDeadlineAt  DateTime?
  reassessmentRequestedAt DateTime?
  reassessmentReason      String?                        @db.Text
  oralDefenseDeadlineAt   DateTime?
  oralDefenseScheduledAt  DateTime?
  oralDefenseAccessUrl    String?                        @db.VarChar(500)
  oralDefenseHeldAt       DateTime?
  oralDefenseRecordingUrl String?                        @db.VarChar(500)
  oralDefenseNotes        String?                        @db.Text
  appealDeadlineAt        DateTime?
  appealSubmittedAt       DateTime?
  appealReason            String?                        @db.Text
  appealDecidedAt         DateTime?
  appealDecisionText      String?                        @db.Text
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  deletedDate             DateTime?

  process         CareerProcess                 @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  memorialFile    EvidenceFile?                 @relation("FullProfessorMemorialFile", fields: [memorialFileId], references: [idEvidenceFile], onDelete: SetNull)
  thesisFile      EvidenceFile?                 @relation("FullProfessorThesisFile", fields: [thesisFileId], references: [idEvidenceFile], onDelete: SetNull)
  doctorateDegree TeacherDegree?                @relation(fields: [doctorateDegreeId], references: [idTeacherDegree], onDelete: SetNull)
  procedureEvents FullProfessorProcedureEvent[]

  @@index([memorialFileId])
  @@index([thesisFileId])
  @@index([doctorateDegreeId])
  @@map("full_professor_process_detail")
}

model FullProfessorProcedureEvent {
  idFullProfessorProcedureEvent Int                             @id @default(autoincrement())
  processId                     Int
  type                          FullProfessorProcedureEventType
  actorId                       Int
  details                       Json?
  occurredAt                    DateTime                        @default(now())
  deletedDate                   DateTime?

  processDetail FullProfessorProcessDetail @relation(fields: [processId], references: [processId], onDelete: Cascade)
  actor         User                       @relation(fields: [actorId], references: [idUser], onDelete: Restrict)

  @@index([processId, occurredAt])
  @@index([actorId])
  @@map("full_professor_procedure_event")
}

model DocumentTemplate {
  idDocumentTemplate Int       @id @default(autoincrement())
  code               String    @unique @db.VarChar(60)
  name               String    @db.VarChar(120)
  processTypeId      Int?
  version            String    @db.VarChar(30)
  templateFile       String?   @db.VarChar(500)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedDate        DateTime?

  processType            ProcessTypeConfig?  @relation("ProcessTypeTemplates", fields: [processTypeId], references: [idProcessType], onDelete: SetNull)
  defaultForProcessTypes ProcessTypeConfig[] @relation("DefaultOpinionTemplate")
  generatedDocuments     DocumentProcess[]

  @@index([processTypeId])
  @@map("document_template")
}

model DocumentProcess {
  idDocumentProcess Int       @id @default(autoincrement())
  processId         Int
  templateId        Int?
  documentType      String    @db.VarChar(80)
  nature            String?   @db.VarChar(80)
  detailedSubject   String?   @db.VarChar(255)
  format            String?   @db.VarChar(30)
  receivedAt        DateTime?
  checked           Boolean   @default(false)
  evidenceFileId    Int?
  generatedById     Int?
  purpose           String?   @db.VarChar(120)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedDate       DateTime?

  process      CareerProcess     @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  template     DocumentTemplate? @relation(fields: [templateId], references: [idDocumentTemplate], onDelete: SetNull)
  evidenceFile EvidenceFile?     @relation(fields: [evidenceFileId], references: [idEvidenceFile], onDelete: SetNull)
  generatedBy  User?             @relation(fields: [generatedById], references: [idUser], onDelete: SetNull)

  @@index([processId])
  @@index([templateId])
  @@index([evidenceFileId])
  @@index([generatedById])
  @@map("document_process")
}

model CppdCommission {
  idCppdCommission Int       @id @default(autoincrement())
  campusId         Int?
  ordinance        String?   @db.VarChar(120)
  mandateStart     DateTime?
  mandateEnd       DateTime?
  validityStart    DateTime?
  validityEnd      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedDate      DateTime?

  campus  Campus?                @relation(fields: [campusId], references: [idCampus], onDelete: SetNull)
  members CppdCommissionMember[]

  @@index([campusId])
  @@map("cppd_commission")
}

model CppdCommissionMember {
  commissionId   Int
  personId       Int
  function       CppdMemberFunction       @default(MEMBER)
  membershipType CommissionMembershipType @default(PRIMARY)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedDate    DateTime?

  commission CppdCommission @relation(fields: [commissionId], references: [idCppdCommission], onDelete: Cascade)
  person     Person         @relation(fields: [personId], references: [idPerson], onDelete: Restrict)

  @@id([commissionId, personId])
  @@index([personId])
  @@map("cppd_commission_member")
}

model SpecialCommission {
  idSpecialCommission  Int                   @id @default(autoincrement())
  processId            Int
  type                 SpecialCommissionType
  ordinance            String?               @db.VarChar(120)
  ordinanceDate        DateTime?
  evaluationDeadlineAt DateTime?
  status               CommissionStatus      @default(DRAFT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedDate          DateTime?

  process CareerProcess             @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  members SpecialCommissionMember[]

  @@index([processId])
  @@map("special_commission")
}

model SpecialCommissionMember {
  idSpecialCommissionMember Int                           @id @default(autoincrement())
  specialCommissionId       Int
  personId                  Int
  origin                    SpecialCommissionMemberOrigin
  role                      SpecialCommissionMemberRole   @default(MEMBER)
  sortOrder                 Int                           @default(0)
  acceptanceStatus          AcceptanceStatus              @default(PENDING)
  acceptedAt                DateTime?
  conflictDeclarationAt     DateTime?
  responseReason            String?                       @db.VarChar(1000)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  deletedDate               DateTime?

  specialCommission     SpecialCommission      @relation(fields: [specialCommissionId], references: [idSpecialCommission], onDelete: Cascade)
  person                Person                 @relation(fields: [personId], references: [idPerson], onDelete: Restrict)
  individualEvaluations IndividualEvaluation[]

  @@unique([specialCommissionId, personId])
  @@index([personId])
  @@map("special_commission_member")
}

model IndividualEvaluation {
  idIndividualEvaluation Int                         @id @default(autoincrement())
  processId              Int
  memberId               Int?
  type                   IndividualEvaluationType
  status                 IndividualEvaluationStatus  @default(DRAFT)
  result                 IndividualEvaluationResult?
  recognizedPoints       Decimal?                    @db.Decimal(10, 2)
  opinionText            String?                     @db.Text
  submittedAt            DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedDate            DateTime?

  process CareerProcess               @relation(fields: [processId], references: [idProcess], onDelete: Cascade)
  member  SpecialCommissionMember?    @relation(fields: [memberId], references: [idSpecialCommissionMember], onDelete: SetNull)
  scores  IndividualEvaluationScore[]

  @@index([processId])
  @@index([memberId])
  @@map("individual_evaluation")
}

model IndividualEvaluationScore {
  idIndividualEvaluationScore Int       @id @default(autoincrement())
  individualEvaluationId      Int
  itemId                      Int
  quantity                    Int       @default(0)
  awardedPoints               Decimal   @db.Decimal(10, 2)
  evaluatorComment            String?   @db.VarChar(500)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedDate                 DateTime?

  individualEvaluation IndividualEvaluation @relation(fields: [individualEvaluationId], references: [idIndividualEvaluation], onDelete: Cascade)
  item                 ScoringItem          @relation(fields: [itemId], references: [idScoringItem], onDelete: Restrict)

  @@unique([individualEvaluationId, itemId])
  @@index([itemId])
  @@map("individual_evaluation_score")
}

model EvidenceFile {
  idEvidenceFile Int       @id @default(autoincrement())
  userId         Int
  usageType      String?   @db.VarChar(60)
  originalName   String    @db.VarChar(180)
  storedName     String    @db.VarChar(180)
  url            String    @db.VarChar(500)
  mimeType       String?   @db.VarChar(60)
  sizeBytes      BigInt?
  uploadedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedDate    DateTime?

  user                     User                         @relation(fields: [userId], references: [idUser], onDelete: Cascade)
  scores                   ProcessScore[]
  teacherDegrees           TeacherDegree[]
  documentProcesses        DocumentProcess[]
  rscReports               RscProcessDetail[]           @relation("RscReportFile")
  rscGeneratedSpreadsheets RscProcessDetail[]           @relation("RscGeneratedSpreadsheetFile")
  fullProfessorMemorials   FullProfessorProcessDetail[] @relation("FullProfessorMemorialFile")
  fullProfessorTheses      FullProfessorProcessDetail[] @relation("FullProfessorThesisFile")

  @@index([userId, deletedDate])
  @@index([usageType])
  @@map("evidence_file")
}

model PasswordResetCode {
  idPasswordResetCode Int       @id @default(autoincrement())
  userId              Int
  codeHash            String    @db.VarChar(200)
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  updatedAt   DateTime  @updatedAt
  deletedDate DateTime?

  user User @relation(fields: [userId], references: [idUser], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_code")
}
