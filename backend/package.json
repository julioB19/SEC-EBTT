{
  "name": "tcc",
  "version": "1.0.0",
  "scripts": {
    "prestart:dev": "ts-node scripts/database-setup",
    "start:dev": "nodemon src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:status": "npx prisma migrate status",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:db:setup": "ts-node scripts/test-database-setup.ts",
    "test:unit": "npx jest test/unit --coverage=false",
    "test:integration": "npx jest test/integration --runInBand",
    "test": "npx jest test --runInBand --coverage=false",
    "test:coverage": "npx jest test --config jest.regulatory.config.js --runInBand",
    "test:coverage:all": "npx jest test --runInBand --coverage",
    "husky:init": "husky",
    "lint": "npx eslint",
    "build": "tsc",
    "seeds": "ts-node scripts/seeds",
    "seed:demo": "ts-node scripts/seed-demo.ts",
    "db:reset:demo": "ts-node scripts/reset-demo.ts",
    "test:demo": "ts-node scripts/verify-demo.ts",
    "migrate:cpf": "ts-node scripts/migrate-cpf-protection",
    "format:prisma": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cpf-cnpj-validator": "^1.0.3",
    "dayjs": "^1.11.18",
    "docxtemplater": "^3.67.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "libreoffice-convert": "^1.7.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "serverless-http": "^3.2.0",
    "sharp": "^0.34.5",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@faker-js/faker": "^9.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.8.1"
  }
}
