{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "test": "npm run typecheck && npm run check:ux && npm run test:interaction",
    "typecheck": "tsc --noEmit",
